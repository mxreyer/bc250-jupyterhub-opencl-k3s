# Host-specific values for the k8s manifests.
#
#   cp k8s/env.example k8s/env.local     # k8s/env.local is gitignored
#   $EDITOR k8s/env.local
#   ./k8s/render.sh                       # writes k8s/**/<name>.yaml from <name>.yaml.tmpl
#
# Plain KEY=value, one per line, no quotes. The rendered *.yaml files are
# gitignored; the *.yaml.tmpl files and this example are what's committed.

# LAN IP of the box. Used in the sslip.io Ingress host:
#   hub.<NODE_LAN_IP>.sslip.io
NODE_LAN_IP=192.168.1.100

# Tailscale node name for the Hub sidecar -> <TS_HOSTNAME>.<TS_TAILNET>.
TS_HOSTNAME=juphub

# Your tailnet's DNS name (Tailscale admin console -> DNS -> Tailnet name).
# No leading dot, no scheme.
TS_TAILNET=your-name.ts.net

# ACL tag the Tailscale auth key is authorized for. If the key is created
# pre-tagged, set this anyway (harmless) or delete the TS_EXTRA_ARGS env in
# k8s/jupyterhub/50-deployment.yaml.tmpl.
TS_TAG=tag:juphub

# JupyterHub admin username: auto-approved on signup, manages other users.
HUB_ADMIN=max
